    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(cnpg_pg_database_size_bytes{namespace=\"weather-db\",datname=\"weather\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
