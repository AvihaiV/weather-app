{
 "uid": "weather-db",
 "title": "Weather \u00b7 Database",
 "description": "PostgreSQL (CloudNativePG): availability, replication, load",
 "tags": [
  "weather"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "editable": true,
 "panels": [
  {
   "type": "row",
   "title": "Availability",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Instances up",
   "description": "1 primary + 2 replicas expected",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(cnpg_collector_up{namespace=\"weather-db\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 2
       },
       {
        "color": "green",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Current primary",
   "description": "The instance accepting writes. Changes after a failover.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "cnpg_pg_replication_in_recovery{namespace=\"weather-db\"} == 0",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Max replication lag",
   "description": "How far the slowest replica is behind the primary",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(cnpg_pg_replication_lag{namespace=\"weather-db\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Database size",
   "description": "",
