    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Connections by instance",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pod) (cnpg_backends_total{namespace=\"weather-db\"})",
     "legendFormat": "{{pod}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
